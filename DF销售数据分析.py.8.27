import numpy as np
import pandas as pd
data = {"产品名称":["A","B","C","D"],
        "单价":[100,150,200,120],
        "销量":[50,30,20,40]
}
df = pd.DataFrame(data)
df["总销售额"] = df ["单价"]*df["销量"]
print(df)
print(df.nlargest(1,columns = ["总销售额"]))
print(df.sort_values("总销售额",ascending=False))
data1 = {
    "用户ID":[101,102,103,104,105],
    "用户名":["Alice","Bob","Charlie","David","Eve"],
    "商品类别":["电子产品","服饰","电子产品","家居","服饰"],
    "商品单价":[1200,300,800,150,200],
    "购买数量":[1,3,2,5,4]
}
df = pd.DataFrame(data1)
df["消费金额"]= df["商品单价"]*df["购买数量"]
print(df)
#找消费数量最高的
print(df.nlargest(1,columns=["消费金额"]))#会打印整行
print("平均客单价：",df["消费金额"].mean())
#统计电子产品的总购买数量
print(df[df["商品类别"] == "电子产品"]["购买数量"].sum)